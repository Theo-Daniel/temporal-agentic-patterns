# Copy this file to .env and adjust values as needed.
# All variables are optional — sensible localhost defaults are used if unset.

# Temporal server address (host:port)
TEMPORAL_ADDRESS=localhost:7233

# Temporal task queue shared by the worker and CLI
TASK_QUEUE=expense-task-queue

# Ollama chat REST API endpoint (multi-turn — used for both extraction and fraud-risk classification)
OLLAMA_CHAT_URL=http://localhost:11434/api/chat

# Ollama model used for receipt extraction and fraud-risk classification
OLLAMA_MODEL=llama3.2

# Base URL of the streaming UI to push live token deltas to (unset disables streaming)
UI_STREAM_URL=

# Event-history length that triggers continue-as-new on the orchestrator (code default: 20)
HISTORY_LENGTH_THRESHOLD=10  # lower than the code default (20) so continue-as-new actually fires in a demo run

# Path to the JSONL file used as a stand-in external store for continue-as-new snapshots
CONTEXT_STORE_PATH=context_store.jsonl
